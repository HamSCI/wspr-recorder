[Unit]
Description=wspr-recorder carrier archive browser: WW0WWV vs WWV (read-only web page)
Documentation=file:///opt/git/sigmond/wspr-recorder/docs/CARRIER-ARCHIVE.md
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=10

# Installed but NOT enabled: it is only useful where [carrier_archive]
# enabled = true.  Turn it on with
#   sudo systemctl enable --now wspr-carrier-browser.service
# and reach it from your own machine with
#   ssh -L 8089:127.0.0.1:8089 <host>     then open http://localhost:8089/

[Service]
Type=simple
User=wsprrec
Group=wsprrec

# Must match [carrier_archive] root in the recorder's config.  Override with
# a drop-in (systemctl edit wspr-carrier-browser) if you changed it there.
Environment=CARRIER_ARCHIVE_ROOT=/var/lib/wspr-recorder/carrier-archive
# Address and port.  Loopback by default.  A host relay (e.g. the Proxmox
# host forwarding to this VM, as for station-web on :8000) needs a drop-in:
#   [Service]
#   Environment=CARRIER_BROWSER_BIND=0.0.0.0
#   IPAddressAllow=<the relay's address or subnet>
#   Environment=CARRIER_BROWSER_ALLOWED_HOSTS=<names users type, if any>
# The page has no authentication: whoever reaches the port can read the
# archive.  See docs/CARRIER-ARCHIVE.md.
Environment=CARRIER_BROWSER_BIND=127.0.0.1
Environment=CARRIER_BROWSER_PORT=8089
# Host names (besides IP addresses, localhost and this host's name) the page
# answers to; comma-separated.  Anything else gets 403 (DNS rebinding).
Environment=CARRIER_BROWSER_ALLOWED_HOSTS=
# WWV's Doppler is measured on hf-timestd's raw IQ buffers (read-only,
# through /usr/bin/zstd -dc): these roots, colon-separated, first wins;
# "none" to use only the database below.
Environment=TIMESTD_RAW_BUFFER=/var/lib/timestd/raw_buffer:/dev/shm/timestd/raw_buffer
# 1: measure the current UTC day's WWV in the background (one file at a
# time, a quarter duty cycle); 0: only when a page asks.
Environment=CARRIER_BROWSER_WWV_PREFILL=1
# hf-timestd's database: only a fallback, labelled unreliable, for a WWV
# frequency with no raw buffer (its L2 doppler_hz is noise on hf-timestd
# 5.0.0).  Read-only; "none" for no fallback.
Environment=TIMESTD_DB=/var/lib/timestd/phase2/timestd.db
# The sink with wspr-recorder's noise rows, for signal levels in dBm
# (read-only).  Empty: found as hamsci_sink finds it; "none" for no levels.
Environment=CARRIER_BROWSER_SINK_DB=

WorkingDirectory=/opt/git/sigmond/wspr-recorder
# --bind, --port, the Host list and the database come from the environment.
ExecStart=/opt/git/sigmond/wspr-recorder/venv/bin/python3 -m wspr_recorder.carrier_browser \
    --root ${CARRIER_ARCHIVE_ROOT}

Restart=on-failure
RestartSec=30

StandardOutput=journal
StandardError=inherit
SyslogIdentifier=wspr-carrier-browser

Nice=10
MemoryMax=256M
# A day's first comparison measures every carrier (numpy FFTs), and WWV's
# raw IQ is decompressed and decimated once per 10-minute file (~0.3-1 s
# of CPU each, then cached); keep it from starving the recorders.
CPUQuota=50%
MemorySwapMax=0

# Read-only by construction: the page never writes the archive or
# hf-timestd's files, and the sandbox makes the whole file system read-only
# for it (ProtectSystem=strict, no ReadWritePaths) except its own cache of
# WWV carrier results, /var/cache/wspr-carrier-browser/wwv-carrier.sqlite
# (~1 MB a day, 30 days kept; $CACHE_DIRECTORY).  Deleting it only costs
# re-measuring what the raw buffers still hold.
CacheDirectory=wspr-carrier-browser
CacheDirectoryMode=0750
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
# Loopback only, even if the bind above is changed.  To serve a relay or a
# LAN, change CARRIER_BROWSER_BIND *and* add IPAddressAllow= in a drop-in
# (drop-ins add to this list) -- knowingly: the page has no authentication.
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
